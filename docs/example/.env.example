# Databasus API
DATABASUS_API_URL=http://127.0.0.1:4005/api/v1

# Admin credentials from first Databasus startup
DATABASUS_ADMIN_EMAIL=admin@example.com
DATABASUS_ADMIN_PASSWORD=change-me

# Example resource names
DATABASUS_EXAMPLE_WORKSPACE_NAME=ansible-example-workspace
DATABASUS_EXAMPLE_STORAGE_NAME=ansible-example-local-storage
DATABASUS_EXAMPLE_DATABASE_NAME=ansible-example-postgres-physical

# PostgreSQL 18 target (reachable from Databasus container)
DATABASUS_EXAMPLE_POSTGRES_HOST=postgres18
DATABASUS_EXAMPLE_POSTGRES_PORT=5432
DATABASUS_EXAMPLE_POSTGRES_USER=postgres
DATABASUS_EXAMPLE_POSTGRES_PASSWORD=postgres
DATABASUS_EXAMPLE_POSTGRES_VERSION=18

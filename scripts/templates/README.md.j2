## Basic usage

```yaml
- name: Manage database
  hosts: localhost
  tasks:
    - name: Create database
      zeqk.databasus.database:
        state: present
        api_url: "https://api.databasus.example.com"
        api_token: "{{ '{{' }} lookup('env', 'DATABASUS_TOKEN') {{ '}}' }}"
        name: "production-db"

    - name: Delete database
      zeqk.databasus.database:
        state: absent
        api_url: "https://api.databasus.example.com"
        api_token: "{{ '{{' }} lookup('env', 'DATABASUS_TOKEN') {{ '}}' }}"
        name: "production-db"
```
